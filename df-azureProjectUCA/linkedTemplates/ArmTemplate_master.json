{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "df-azureProjectUCA"
		},
		"AzureSQL_linkedService_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSQL_linkedService'"
		},
		"dataLake_linkedservice_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'dataLake_linkedservice'"
		},
		"AzureSQL_linkedService_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "serverazureprojectuca.database.windows.net"
		},
		"AzureSQL_linkedService_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db_AzureProject"
		},
		"AzureSQL_linkedService_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adminumut"
		},
		"dataLake_linkedservice_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://umutcanasci.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "df-azureProjectUCA_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureSQL_linkedService_password": {
						"value": "[parameters('AzureSQL_linkedService_password')]"
					},
					"dataLake_linkedservice_accountKey": {
						"value": "[parameters('dataLake_linkedservice_accountKey')]"
					},
					"AzureSQL_linkedService_properties_typeProperties_server": {
						"value": "[parameters('AzureSQL_linkedService_properties_typeProperties_server')]"
					},
					"AzureSQL_linkedService_properties_typeProperties_database": {
						"value": "[parameters('AzureSQL_linkedService_properties_typeProperties_database')]"
					},
					"AzureSQL_linkedService_properties_typeProperties_userName": {
						"value": "[parameters('AzureSQL_linkedService_properties_typeProperties_userName')]"
					},
					"dataLake_linkedservice_properties_typeProperties_url": {
						"value": "[parameters('dataLake_linkedservice_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}